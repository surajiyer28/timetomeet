DATABASE_URL=postgresql+asyncpg://timetomeet:timetomeet@postgres:5432/timetomeet
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
MCP_SERVER_URL=http://mcp-server:8001
ANTHROPIC_API_KEY=sk-ant-...
FRONTEND_URL=http://localhost:3000

# Email — defaults to the local Mailpit container (catches all mail at http://localhost:8025).
# For real email, point at an SMTP relay and set user/password (e.g. Gmail app password on 587).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TimeToMeet <noreply@timetomeet.local>

# Google Calendar (optional). Leave blank to run DB-only. Create a Web OAuth client in Google
# Cloud with redirect URI http://localhost:8080/auth/google/callback, enable the Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
